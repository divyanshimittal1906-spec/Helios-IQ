# Application & Authentication
APP_ENV=development
SECRET_KEY=your-production-secret-key-min-32-chars
JWT_SECRET_KEY=your-production-jwt-secret-key-min-32-chars
AUTH_SECRET=your-production-auth-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/helios_iq
POSTGRES_DB=helios_iq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Provider
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_PROVIDER=openai

# Embedding and RAG
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MAX_RETRIES=2
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_TOKENS=2000

# Document processing
MAX_DOCUMENT_SIZE=10485760
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DOCUMENT_STORAGE_PATH=storage/documents

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
